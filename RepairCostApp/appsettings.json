{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=repair_cost_db;Username=postgres;Password=postgres;"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "MinimumLevel": "Information",
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/repair_log.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    }
}